# ─── Server ─────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Redis ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Storage Paths ──────────────────────────────────
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output

# ─── Compression ────────────────────────────────────
MAX_CONCURRENT_COMPRESSIONS=3
DEFAULT_ALGORITHM=zstd
DEFAULT_COMPRESSION_LEVEL=3

# ─── File Limits ────────────────────────────────────
MAX_FILE_SIZE_GB=200
CHUNK_SIZE_MB=5
MAX_CONCURRENT_UPLOADS=5

# ─── Cleanup TTLs ──────────────────────────────────
TEMP_FILE_TTL_HOURS=1
OUTPUT_FILE_TTL_HOURS=24

# ─── Gemini AI (Optional) ──────────────────────────
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
